{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@tenunjs/jsx-runtime",
    "types": ["bun-types"],
    "skipLibCheck": true
  },
  "include": ["src", "scripts"]
}
