{
  "name": "tenunjs-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "verify:ts": "bun install --frozen-lockfile && bun test",
    "verify:rust": "./.github/scripts/verify-rust.sh",
    "verify:abi": "./.github/scripts/verify-abi.sh",
    "verify:evidence": "python3 ./.github/scripts/verify-evidence.py",
    "verify": "bun run verify:ts && bun run verify:rust && bun run verify:abi && bun run verify:evidence"
  }
}
