<?xml version="1.0" encoding="utf-8"?>
<!-- TN-195 (ADR-0028): TV packaging overlay, merged over src/main by the
     tv flavor. The launch activity gains a LEANBACK_LAUNCHER intent-filter
     (manifest merger appends intent-filters, so the touch LAUNCHER entry
     stays intact); leanback becomes required and touchscreen optional, so
     the APK installs as an Android TV app and still installs on touch-only
     hardware; the application label and the 320x180 banner (x1dp,
     drawable-xhdpi) carry the Tenun TV identity in the TV launcher. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:label="Tenun TV"
        android:banner="@drawable/banner"
        tools:replace="android:label">

        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
